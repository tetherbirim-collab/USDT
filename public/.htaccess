DirectoryIndex index.php index.html

<Files "heleket.config.php">
  Require all denied
</Files>

<Files "pst.config.php">
  Require all denied
</Files>

<Files "heleket-payments.json">
  Require all denied
</Files>

<Files "clay-ledger.json">
  Require all denied
</Files>

<Files "clay-seed.json">
  Require all denied
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^index\.php$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ $1/ [R=301,L,QSA]
</IfModule>
