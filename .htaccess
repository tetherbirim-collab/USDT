# Stock Apache: this file must be mode 644 or the vhost returns 403
# before any page is served (AH00529, unreadable htaccess).
Options -MultiViews
DirectoryIndex index.php index.html

<Files "heleket.config.php">
  Require all denied
</Files>

<Files "kripicard.config.php">
  Require all denied
</Files>

<Files "heleket-payments.json">
  Require all denied
</Files>

<Files "clay-ledger.json">
  Require all denied
</Files>

<Files "clay-seed.json">
  Require all denied
</Files>

<Files "clay-live.json">
  Require all denied
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^lang\.php$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^(.*\.html)$ /lang.php?clay_html=$1 [L,QSA]
  RewriteCond %{REQUEST_URI} ^/(.+?)/?$
  RewriteCond %{DOCUMENT_ROOT}/%1/index.html -f
  RewriteCond %{DOCUMENT_ROOT}/%1/index.php !-f
  RewriteRule ^ /lang.php?clay_html=%1/index.html [L,QSA]
  RewriteCond %{HTTP_ACCEPT} text/html [NC]
  RewriteRule ^(.*/)?index\.txt$ /$1 [R=302,L]
  RewriteRule ^index\.php$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L,QSA]
</IfModule>
