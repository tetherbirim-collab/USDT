Options -MultiViews
DirectoryIndex index.php index.html

<Files "heleket.config.php">
  Require all denied
</Files>

<Files "kripicard.config.php">
  Require all denied
</Files>

<Files "heleket-payments.json">
  Require all denied
</Files>

<Files "clay-ledger.json">
  Require all denied
</Files>

<Files "clay-seed.json">
  Require all denied
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_ACCEPT} text/html [NC]
  RewriteRule ^(.*/)?index\.txt$ /$1 [R=302,L]
  RewriteRule ^index\.php$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ $1/ [R=301,L,QSA]
</IfModule>
